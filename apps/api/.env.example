# Required. PostgreSQL URL, same database as packages/db/.env.
DATABASE_URL=postgresql://organizer:organizer-dev@127.0.0.1:54329/social_organizer_dev?schema=public
# Required. Signing key of at least 16 characters. Use this public value only for local development.
JWT_SECRET=local-development-only-change-me
# Optional. Fastify port (default 3001).
PORT=3061
# Optional. Address to listen on (default 0.0.0.0).
HOST=127.0.0.1
# Optional. Public web origin used for share links, redirects, and CORS.
WEB_APP_URL=http://localhost:3060
# Optional. Additional web origin for CORS (defaults to the apex domain of the original deployment).
WEB_APP_ALT_URL=
# Optional. Redis URL for BullMQ workers. Leave blank to skip Redis, or use redis://127.0.0.1:63799 with Compose.
REDIS_URL=
# Optional. Node runtime mode. Development enables the local mail outbox when no mail provider is configured.
NODE_ENV=development
# Optional. Comma-separated admin user IDs.
ADMIN_IDS=

# Optional. Leave empty locally. A token can redirect the production Telegram bot's webhook.
TELEGRAM_BOT_TOKEN=
# Optional. Public Telegram bot username without @ (defaults to socialorganizer_bot).
TELEGRAM_BOT_USERNAME=
# Optional. Legacy API alias for TELEGRAM_BOT_USERNAME.
VITE_TELEGRAM_BOT_USERNAME=
# Optional. Set to 1 to enable the Telegram Login Widget when the bot is configured.
TELEGRAM_LOGIN_WIDGET=0
# Optional. Telegram chat ID for forwarding feedback.
FEEDBACK_CHAT_ID=
# Optional. Telegram chat ID for support, bot forwarding, and broadcast copies (defaults to the original support chat).
SUPPORT_CHAT_ID=

# Optional. Resend key for real delivery. Leave blank to use the local mail outbox in development.
RESEND_API_KEY=
# Optional. Verified Resend sender in the form Name <sender@example.com>.
MAIL_FROM=
# Optional. Dev mail outbox path, relative to apps/api when run by pnpm dev.
DEV_MAIL_OUTBOX=./so-dev-mail.log
# Optional. Set to 1 only on a test instance to write emails and sign-in codes to stdout.
MAIL_LOG_TO_STDOUT=0

# Optional. Google OAuth client ID. Use the same client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional. Apple Sign In Services ID. Use the same ID as VITE_APPLE_SERVICE_ID.
APPLE_SERVICE_ID=
# Optional. Apple team ID for Universal Links and the default APNs team.
APPLE_TEAM_ID=
# Optional. iOS bundle ID for Universal Links, Apple Sign In and the default APNs topic.
APPLE_BUNDLE_ID=
# Optional. Android app ID for App Links and native auth return.
ANDROID_APP_PACKAGE=
# Optional. Comma-separated Android signing certificate SHA-256 fingerprints for App Links.
ANDROID_CERT_SHA256=
# Optional. Apple Pay domain association verification file contents.
APPLE_DOMAIN_ASSOCIATION=
# Optional. Deep-link URL scheme for native auth return (defaults to socialorganizer).
NATIVE_AUTH_SCHEME=

# Optional. VAPID public key for Web Push.
VAPID_PUBLIC_KEY=
# Optional. VAPID private key for Web Push.
VAPID_PRIVATE_KEY=
# Optional. VAPID contact URI (mailto: or https:).
VAPID_SUBJECT=
# Optional. Firebase service-account JSON for FCM on Android.
FIREBASE_SERVICE_ACCOUNT=
# Optional. APNs signing key (.p8 contents, with escaped newlines if needed).
APNS_KEY=
# Optional. APNs signing key ID.
APNS_KEY_ID=
# Optional. APNs team override (falls back to APPLE_TEAM_ID).
APNS_TEAM_ID=
# Optional. APNs bundle ID override (falls back to APPLE_BUNDLE_ID).
APNS_BUNDLE_ID=
# Optional. Set to 1 to use the APNs sandbox.
APNS_SANDBOX=0

# Optional. xAI key for the assistant and FAQ localization.
XAI_API_KEY=
# Optional. OpenAI key for the assistant fallback, voice, and localization fallback.
OPENAI_API_KEY=
# Optional. Maximum assistant requests per person per hour.
CHAT_LIMIT_PER_HOUR=30
# Optional. Maximum assistant requests per person per day.
CHAT_LIMIT_PER_DAY=100
# Optional. Maximum assistant requests for all users per day.
CHAT_LIMIT_ALL_PER_DAY=5000
# Optional. Maximum voice requests per person per hour.
SPEAK_LIMIT_PER_HOUR=40
# Optional. Maximum voice requests for all users per day.
SPEAK_LIMIT_ALL_PER_DAY=3000

# Optional. Set to true to enable the skills and matching API.
FEATURE_SKILLS=false
# Optional. Maximum time in milliseconds that a graph invalidation can stay pending.
GRAPH_PENDING_TTL_MS=30000
# Optional. Time in milliseconds that a cached network reach count can be reused while refreshing.
REACH_STALE_MS=60000
# Optional. Minimum far-ring count eligible for reuse across graph versions.
REACH_FAR_REUSE_MIN=500
# Optional. Synthetic user count for the graph-store benchmark script only.
BENCH_PEOPLE=100000
