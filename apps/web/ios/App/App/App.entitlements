<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications through APNs (the API sends to iOS tokens directly, see apns.service.ts) -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links: /invite/, /i/ and /sos/ open the app (apple-app-site-association is served by the API) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.orginizer.com</string>
		<string>applinks:orginizer.com</string>
	</array>
</dict>
</plist>
