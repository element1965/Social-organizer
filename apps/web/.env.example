# Optional. Vite dev server port (default 3000).
DEV_WEB_PORT=3060
# Optional. Backend target for the Vite dev proxy (default http://localhost:3001).
DEV_API_TARGET=http://127.0.0.1:3061
# Optional. Public origin for web, sharing, and OAuth (defaults to the original production origin).
VITE_WEB_APP_URL=http://localhost:3060
# Optional. Alternate origin accepted by invite links and QR scans.
VITE_WEB_APP_ALT_URL=
# Optional. Public bot username without @. Setting it also enables Telegram Mini App invite links.
VITE_TELEGRAM_BOT_USERNAME=
# Optional. Google OAuth client ID. Match GOOGLE_CLIENT_ID on the API.
VITE_GOOGLE_CLIENT_ID=
# Optional. Google OAuth redirect URI (defaults to /auth/google/callback on VITE_WEB_APP_URL).
VITE_GOOGLE_RETURN_URL=
# Optional. Apple Sign In Services ID. Match APPLE_SERVICE_ID on the API.
VITE_APPLE_SERVICE_ID=
# Optional. Apple OAuth redirect URI (defaults to /api/auth/apple/callback on VITE_WEB_APP_URL).
VITE_APPLE_RETURN_URL=
# Optional. Android application ID for Play Store and auth links. Match ANDROID_APP_PACKAGE on the API.
VITE_ANDROID_APP_PACKAGE=
# Optional. iOS bundle ID used by Capacitor when syncing iOS.
VITE_APPLE_BUNDLE_ID=
# Optional. Numeric App Store ID, without the id prefix.
VITE_IOS_STORE_ID=
# Optional. URL scheme for native auth return. Match NATIVE_AUTH_SCHEME on the API.
VITE_NATIVE_AUTH_SCHEME=

# Vite sets import.meta.env.DEV itself based on whether it runs in development.
