{
  "name": "social-organizer",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:setup": "pnpm --filter @so/db run setup",
    "db:migrate": "pnpm --filter @so/db migrate",
    "db:generate": "pnpm --filter @so/db generate",
    "db:push": "pnpm --filter @so/db push",
    "db:studio": "pnpm --filter @so/db studio",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "2.0.4",
    "globals": "^17.14.0",
    "railway": "3.16.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "googleapis": "^171.4.0",
    "sharp": "^0.35.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "@fastify/busboy@>=3.0.0 <3.2.1": "3.2.1",
      "@grpc/grpc-js@>=1.0.0 <1.14.5": "1.14.5",
      "@prisma/config@6.19.2>deepmerge-ts": "8.0.2",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "brace-expansion@>=1.0.0 <1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.11",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "defu@>=6.0.0 <6.1.5": "6.1.5",
      "effect@>=3.0.0 <3.20.0": "3.20.0",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "fast-xml-builder@>=1.0.0 <1.1.7": "1.1.7",
      "fast-xml-parser@>=5.0.0 <5.5.6": "5.5.6",
      "lodash-es@>=4.0.0 <4.18.0": "4.18.0",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "protobufjs@>=7.0.0 <7.6.1": "7.6.1",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "websocket-driver@>=0.7.0 <0.7.5": "0.7.5",
      "ws@>=7.0.0 <7.5.11": "7.5.11"
    }
  }
}
