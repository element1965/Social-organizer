# Required. PostgreSQL URL for Prisma commands, same database as apps/api/.env.
DATABASE_URL=postgresql://organizer:organizer-dev@127.0.0.1:54329/social_organizer_dev?schema=public
# Optional. Exact host:port override for the standalone staging reset seed. pnpm db:setup only accepts loopback.
SEED_DEV_ALLOW_HOST=
